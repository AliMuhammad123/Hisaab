# Copy this file to .env and fill it in. .env holds your database password:
# it is listed in .gitignore and must never be committed or uploaded anywhere public.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=creditflow
DB_USER=creditflow
DB_PASSWORD=CHANGE_ME
# true when the database is on another machine and supports TLS
DB_SSL=false

# The app listens here. Keep 127.0.0.1 and put an HTTPS proxy (Caddy) in front.
HOST=127.0.0.1
PORT=8080

# Keep true on the live site. false only for testing on your own computer over http://.
SECURE_COOKIES=true
# true only when a reverse proxy you control (Caddy, nginx) sits in front.
TRUST_PROXY=true
# How long a sign-in lasts, in days.
SESSION_DAYS=30
